{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=watchtower;Username=watchtower;Password=watchtower"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "WatchTower",
    "Audience": "WatchTower",
    "ExpiryMinutes": 60
  },
  "Scheduler": {
    "PollIntervalSeconds": 5,
    "MaxConcurrentChecks": 10
  },
  "Monitoring": {
    "RequireHttpsUrls": true,
    "BlockPrivateAddresses": true,
    "MinIntervalSeconds": 30,
    "MaxIntervalSeconds": 86400
  },
  "Notifications": {
    "Enabled": true,
    "DashboardUrl": "http://localhost:5073/",
    "DispatchIntervalSeconds": 5,
    "MaxAttempts": 6
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "Username": "",
    "Password": "",
    "FromAddress": "alerts@watchtower.local",
    "FromName": "WatchTower Alerts",
    "TimeoutSeconds": 30
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 30,
    "ResendCooldownSeconds": 60
  },
  "TwoFactor": {
    "Issuer": "WatchTower",
    "ChallengeLifetimeMinutes": 10,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 30,
    "RecoveryCodeCount": 10
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
